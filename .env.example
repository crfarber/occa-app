# Kopieer naar .env.local (wordt niet gecommit). Geen echte secrets hier.
# EXPO_PUBLIC_* komt in de bundle; de anon key is publiek bedoeld, service_role nooit in de app.

EXPO_PUBLIC_ENVIRONMENT=internal

# Productstandaard: supabase (zelfde accounts als partner). demo alleen voor UI zonder backend.
EXPO_PUBLIC_AUTH_PROVIDER=supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Partner lokaal (apps/partner: next dev --port 3001). Op een fysiek toestel: LAN-IP i.p.v. localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Alternatief zonder backend (CI / snelle UI):
# EXPO_PUBLIC_AUTH_PROVIDER=demo
# EXPO_PUBLIC_API_BASE_URL=

# Azure AD (optioneel, zie ADR 0012):
# EXPO_PUBLIC_AUTH_PROVIDER=azure-ad
# EXPO_PUBLIC_AZURE_AD_TENANT_ID=
# EXPO_PUBLIC_AZURE_AD_CLIENT_ID=
# EXPO_PUBLIC_AZURE_AD_REDIRECT_URL=
# EXPO_PUBLIC_AZURE_AD_SCOPES=
